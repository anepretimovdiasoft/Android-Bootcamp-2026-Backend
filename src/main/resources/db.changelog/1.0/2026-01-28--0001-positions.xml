<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">
    <changeSet id="2026-01-28--0001-positions" author="alikhodievskii">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="positions"/>
            </not>
        </preConditions>
        <createTable tableName="positions">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="position" type="varchar(100)">
                <constraints nullable="false" unique="false" notNullConstraintName="position_not_null"/>
            </column>
        </createTable>

    </changeSet>


</databaseChangeLog>