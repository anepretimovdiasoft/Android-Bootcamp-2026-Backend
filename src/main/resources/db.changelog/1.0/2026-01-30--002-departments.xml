<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="create-departments" author="igramagadev">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="departments"/></not></preConditions>
        <createTable tableName="departments">
            <column name="id" type="INT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="dept_name" type="VARCHAR(255)"><constraints nullable="false" unique="true"/></column>
        </createTable>
    </changeSet>
</databaseChangeLog>