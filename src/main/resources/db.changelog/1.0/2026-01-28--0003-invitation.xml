<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <preConditions>
        <not>
            <tableExists tableName="invitation"/>
        </not>
    </preConditions>

    <changeSet id="2026-01-28--0003-invitation" author="indx0">
        <createTable tableName="invitation">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="message" type="VARCHAR(200)">
                <constraints nullable="true" unique="false" />
            </column>

            <column name="meeting_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_meeting_invitation"
                             referencedTableName="meeting"
                             referencedColumnNames="id"/>
            </column>


            <column name="employee_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_employee_invitation"
                             referencedTableName="employee"
                             referencedColumnNames="id"/>
            </column>

            <column name="status" type="VARCHAR(10)">
                <constraints nullable="true" unique="false" />
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>