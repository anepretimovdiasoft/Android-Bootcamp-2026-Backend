<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="2026-01-28--0001-user" author="yiman">
        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="full_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="phone_number" type="VARCHAR(255)"/>
            <column name="photo_url" type="VARCHAR(1000)"/>
            <column name="position" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="load-users-data" author="yiman">
        <loadData
                file="db.changelog/data/csv/2026-01-28--0001-user-data.csv"
                separator=","
                tableName="users">
            <column name="id" type="NUMERIC"/>
            <column name="email" type="STRING"/>
            <column name="full_name" type="STRING"/>
            <column name="phone_number" type="STRING"/>
            <column name="photo_url" type="STRING"/>
            <column name="position" type="STRING"/>
            <column name="username" type="STRING"/>
            <column name="password" type="STRING"/>
        </loadData>
    </changeSet>

</databaseChangeLog>