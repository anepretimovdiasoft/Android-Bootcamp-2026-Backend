<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <changeSet id="2026-02-03--0005-users-authorities.xml" author="apavlov">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="users_authorities"/>
            </not>
        </preConditions>
        <createTable tableName="users_authorities">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="users_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_authority_users"
                             referencedTableName="users"
                             referencedColumnNames="id"
                             deleteCascade="true"/>
            </column>

            <column name="authorities_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_users_authority"
                             referencedTableName="authority"
                             referencedColumnNames="id"
                             deleteCascade="true"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>