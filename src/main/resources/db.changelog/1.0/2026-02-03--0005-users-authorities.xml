<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="2026-02-03--0005-users-authorities" author="aefremenko">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="users_authorities"/>
            </not>
        </preConditions>
        <createTable tableName="users_authorities">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_usersauths_users" referencedTableName="users"
                             referencedColumnNames="id"/>
            </column>
            <column name="authorities_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_usersauths_authorities" referencedTableName="authorities"
                             referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>