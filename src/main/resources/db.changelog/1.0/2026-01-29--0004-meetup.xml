<?xml version="1.0" encoding="utf-8" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="2026-01-29--0004-meetup" author="kbadogin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="meetup"/>
            </not>
        </preConditions>

        <createTable tableName="meetup">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="date" type="DATE">
                <constraints nullable="false"/>
            </column>

            <column name="time" type="TIME">
                <constraints nullable="false"/>
            </column>

            <column name="planner_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_meetup_person" referencedTableName="person" referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>