<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="2026-02-02--0004-user-authority" author="yiman">
        <createTable tableName="user_authorities">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_user_authorities_user"
                             references="users(id)"/>
            </column>
            <column name="authority_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_user_authorities_authority"
                             references="authorities(id)"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="user_authorities"
                       columnNames="user_id, authority_id"
                       constraintName="pk_user_authorities"/>
    </changeSet>

    <changeSet id="load-user-authorities-data" author="yiman">
        <loadData
                file="db.changelog/data/csv/2026-02-02--0004-user-authority-data.csv"
                separator=","
                tableName="user_authorities">
            <column name="user_id" type="NUMERIC"/>
            <column name="authority_id" type="NUMERIC"/>
        </loadData>
    </changeSet>

</databaseChangeLog>