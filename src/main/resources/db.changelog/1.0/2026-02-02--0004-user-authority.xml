<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="2026-02-02--0004-user-authority" author="Yiman">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="user"/>
            <tableExists tableName="authorities"/>
            <not>
                <tableExists tableName="user_authorities"/>
            </not>
        </preConditions>

        <createTable tableName="user_authorities">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_user_auth_user"
                             referencedTableName="user"
                             referencedColumnNames="id"
                             deleteCascade="true"/>
            </column>
            <column name="authority_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_user_auth_authority"
                             referencedTableName="authorities"
                             referencedColumnNames="id"
                             deleteCascade="true"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="user_authorities"
                       columnNames="user_id, authority_id"
                       constraintName="pk_user_authorities"/>
    </changeSet>

</databaseChangeLog>