<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="2026-01-28--0002-meet" author="yiman">
        <createTable tableName="meets">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="meet_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="meet_time" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="organizer_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_meet_organizer"
                             references="users(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="load-meets-data" author="yiman">
        <loadData
                file="db.changelog/data/csv/2026-01-28--0002-meet-data.csv"
                separator=","
                tableName="meets">
            <column name="id" type="NUMERIC"/>
            <column name="title" type="STRING"/>
            <column name="description" type="STRING"/>
            <column name="meet_date" type="DATE"/>
            <column name="meet_time" type="STRING"/>
            <column name="organizer_id" type="NUMERIC"/>
        </loadData>
    </changeSet>


</databaseChangeLog>