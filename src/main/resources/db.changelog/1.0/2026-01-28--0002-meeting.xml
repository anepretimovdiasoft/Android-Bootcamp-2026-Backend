<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="2026-01-28--0002-meeting" author="indx0">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="meeting"/>
            </not>
        </preConditions>
        <createTable tableName="meeting">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(250)">
                <constraints nullable="false" unique="false" />
            </column>
            <column name="description" type="VARCHAR(250)">
                <constraints nullable="false" unique="false" />
            </column>
            <column name="start_time" type="DATETIME">
                <constraints nullable="false" unique="false" />
            </column>
            <column name="end_time" type="DATETIME">
                <constraints nullable="false" unique="false" />
            </column>
            <column name="owner_employee_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_employee_meeting"
                referencedTableName="employee"
                referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>