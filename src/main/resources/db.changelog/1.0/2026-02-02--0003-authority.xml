<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="2026-02-02--0003-authority" author="yiman">
        <createTable tableName="authorities">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="authority" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="load-authorities-data" author="yiman">
        <loadData
                file="db.changelog/data/csv/2026-02-02--0003-authority-data.csv"
                separator=","
                tableName="authorities">
            <column name="id" type="NUMERIC"/>
            <column name="authority" type="STRING"/>
        </loadData>
    </changeSet>

</databaseChangeLog>