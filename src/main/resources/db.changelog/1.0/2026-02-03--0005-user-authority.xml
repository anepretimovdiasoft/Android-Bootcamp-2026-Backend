<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="2026-02-03--0005-user-authority" author="medveed">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="user_authorities"/>
            </not>
        </preConditions>
        
        <createTable tableName="user_authorities">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_userauthority_user"
                             referencedTableName="users"
                             referencedColumnNames="id"/>
            </column>
            <column name="authority_id" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_userauthority_authority"
                             referencedTableName="authorities"
                             referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>