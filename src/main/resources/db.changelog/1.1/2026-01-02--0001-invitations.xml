<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">
<changeSet id="2026-01-02--0001-invitations" author="alikhodievskii">
    <preConditions onFail="MARK_RAN">
        <not>
            <columnExists tableName="invitations" columnName="organizer_id"/>
        </not>
    </preConditions>
    <addColumn tableName="invitations">
        <column name="organizer_id" type="bigint">
            <constraints nullable="false" notNullConstraintName="organizer_id_not_null"/>
        </column>
    </addColumn>
</changeSet>
</databaseChangeLog>