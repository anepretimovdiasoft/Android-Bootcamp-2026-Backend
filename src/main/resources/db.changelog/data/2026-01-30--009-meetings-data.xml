<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="load-meetings" author="igramagadev">
        <loadData file="db.changelog/data/csv/meetings.csv"
                  tableName="meetings"
                  separator=";"
                  quotchar='"'
                  encoding="UTF-8">
            <column name="id" header="id" type="NUMERIC"/>
            <column name="topic" header="topic" type="STRING"/>
            <column name="description" header="description" type="STRING"/>

            <column name="calendar_date" header="calendar_date" type="DATE"/>
            <column name="start_time" header="start_time" type="TIME"/>
            <column name="end_time" header="end_time" type="TIME"/>

            <column name="created_at" header="created_at" type="TIMESTAMP"/>
            <column name="updated_at" header="updated_at" type="TIMESTAMP"/>

            <column name="organizer_id" header="organizer_id" type="NUMERIC"/>
            <column name="room_id" header="room_id" type="NUMERIC"/>
            <column name="type_id" header="type_id" type="NUMERIC"/>
            <column name="status_id" header="status_id" type="NUMERIC"/>
        </loadData>
    </changeSet>
</databaseChangeLog>