<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="2026-01-28--0002-meet-data" author="yiman">
        <loadData tableName="meets"
                  file="db.changelog/data/csv/2026-01-28--0002-meet-data.csv"
                  separator=","
                  quotchar="&quot;">
            <column name="id" type="NUMERIC"/>
            <column name="title" type="STRING"/>
            <column name="description" type="STRING"/>
            <column name="meet_date" type="DATE"/>
            <column name="meet_time" type="TIME"/>
            <column name="organizer_id" type="NUMERIC"/>
        </loadData>
    </changeSet>

</databaseChangeLog>