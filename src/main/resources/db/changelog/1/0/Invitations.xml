<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.0.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <changeSet id="2026-01-26-05" author="Dmitry">
        <createTable tableName="Invitations">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" unique="true"/>
            </column>
            <column name="Booking_id" type="BIGINT">
                <constraints nullable="true" references="Booking(id)" foreignKeyName="fk_Invitations_Booking"/>
            </column>
            <column name="Employee_created" type="BIGINT">
                <constraints nullable="true" references="Employee(id)" foreignKeyName="fk_Invitations_Employee"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>