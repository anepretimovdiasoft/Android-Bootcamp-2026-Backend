<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.0.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <changeSet id="2026-01-23--1" author="Dmitry">
        <createTable tableName="Employee">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" unique="true" primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(100)" >
                <constraints nullable="false" unique="true"/>
             </column>
            <column name="last_name" type="VARCHAR(100)">
                <constraints nullable="false" unique="false"/>
            </column>
            <column name="father_name" type="VARCHAR(100)">
                <constraints nullable="false" unique="false"/>
            </column>
            <column name="mail" type="VARCHAR(100)">
                <constraints nullable="true" unique="true"/>
            </column>
            <column name="Avatar_id" type="BIGINT" defaultValue="1" >
                <constraints nullable="false" unique="false" references="Avatar(id)" foreignKeyName="fk_Avatar_Employee"/>
            </column>
            <column name="age" type="BIGINT" >
                <constraints nullable="false" unique="false" checkConstraint="age>=18"/>
            </column>
            <column name="сhosenness" type="BOOLEAN">
                <constraints nullable="true" unique="false"/>
            </column>
            <column name="password" type="VARCHAR">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>