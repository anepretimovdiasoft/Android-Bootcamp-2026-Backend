<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!-- Load Users data from CSV -->
    <changeSet id="002-load-users-data" author="bootcamp2026">
        <loadData
                file="db/data/users.csv"
                tableName="users"
                separator=","
                encoding="UTF-8">
            <column name="id" type="NUMERIC"/>
            <column name="email" type="STRING"/>
            <column name="password" type="STRING"/>
            <column name="created_at" type="TIMESTAMP"/>
        </loadData>
    </changeSet>

    <!-- Load Profiles data from CSV -->
    <changeSet id="003-load-profiles-data" author="bootcamp2026">
        <loadData
                file="db/data/profiles.csv"
                tableName="profiles"
                separator=","
                encoding="UTF-8">
            <column name="id" type="NUMERIC"/>
            <column name="user_id" type="NUMERIC"/>
            <column name="first_name" type="STRING"/>
            <column name="last_name" type="STRING"/>
            <column name="photo_url" type="STRING"/>
            <column name="phone" type="STRING"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </loadData>
    </changeSet>

    <!-- Load Meetings data from CSV -->
    <changeSet id="004-load-meetings-data" author="bootcamp2026">
        <loadData
                file="db/data/meetings.csv"
                tableName="meetings"
                separator=","
                encoding="UTF-8">
            <column name="id" type="NUMERIC"/>
            <column name="organizer_id" type="NUMERIC"/>
            <column name="title" type="STRING"/>
            <column name="description" type="STRING"/>
            <column name="date" type="DATE"/>
            <column name="start_time" type="TIME"/>
            <column name="end_time" type="TIME"/>
            <column name="created_at" type="TIMESTAMP"/>
        </loadData>
    </changeSet>

    <!-- Load Invitations data from CSV -->
    <changeSet id="005-load-invitations-data" author="bootcamp2026">
        <loadData
                file="db/data/invitations.csv"
                tableName="invitations"
                separator=","
                encoding="UTF-8">
            <column name="id" type="NUMERIC"/>
            <column name="meeting_id" type="NUMERIC"/>
            <column name="user_id" type="NUMERIC"/>
            <column name="status" type="STRING"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </loadData>
    </changeSet>

</databaseChangeLog>